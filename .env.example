# Copy this file to `.env` and fill in the key(s) you want to use.
# Keys typed in the sidebar take priority over these values.

# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude: https://console.anthropic.com/settings/keys
# Documents are embedded locally for free when Claude is selected.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
DEFAULT_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_CHAT_MODEL=claude-opus-5-5
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TEMPERATURE=0.1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
SEARCH_TYPE=similarity
MAX_FILE_SIZE_MB=20
VECTORSTORE_DIR=vectorstore
# Save the index to disk and reload it on restart. Keep false on any shared/public deployment.
PERSIST_INDEX=false
LOG_LEVEL=INFO
